NEXT_PUBLIC_SUPABASE_URL=https://jouw-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=jouw-publishable-of-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

MUX_TOKEN_ID=jouw-mux-token-id
MUX_TOKEN_SECRET=jouw-mux-token-secret
# Apart van de API-tokens; nodig voor signed videoplayback.
MUX_SIGNING_KEY_ID=jouw-mux-signing-key-id
MUX_SIGNING_PRIVATE_KEY=jouw-base64-gecodeerde-private-key

# AI features (Mentor Copilot e.a.). Server-only, nooit NEXT_PUBLIC.
ANTHROPIC_API_KEY=sk-ant-...
# Optioneel: overschrijft het default model uit lib/ai/registry.ts.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Alleen nodig als server-only scripts later de service role gebruiken.
# SUPABASE_SERVICE_ROLE_KEY=jouw-service-role-key

# Stripe Billing (server-only). Product: €99/maand inclusief btw.
# STRIPE_SECRET_KEY=sk_...
# STRIPE_SUBSCRIPTION_PRICE_ID=price_...
# STRIPE_ACADEMY_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Alleen op true zetten nadat de goedgekeurde voorwaarden-URL bij Stripe is ingesteld.
# STRIPE_COLLECT_TERMS_OF_SERVICE=false
